# GitHub PAT — fine-grained, Contents+Metadata read-only on target repos.
# Reuse the same token currently in gh-mcp-docker/.env.
GH_TOKEN=ghp_replace_me

# Server bind
PORT=8000
HOST=0.0.0.0

# Clone lifecycle
#
# These are memory settings, not disk settings. /tmp/repos is a tmpfs, and tmpfs
# pages are charged to the container's memory cgroup as `shmem`. Cloned bytes are
# container memory one-for-one, so TMPFS_QUOTA_MB must stay well under the
# compose memory limit -- never above it.
CLONE_TTL_SEC=1800           # idle TTL before GC sweep evicts a workspace
CLONE_MAX_SIZE_MB=350        # reject clone if repo size exceeds (gh api size sniff)
TMPFS_QUOTA_MB=448           # keep BELOW the compose tmpfs size (512m) so the
                             # manager LRU-evicts before the mount hits ENOSPC
CLONE_REUSE_WINDOW_SEC=300   # same repo+ref+depth re-requested inside this window
                             # shares the existing checkout instead of re-cloning.
                             # 0 disables reuse.
